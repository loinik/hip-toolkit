<Window
    x:Class="HIPToolkit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HIPToolkit"
    Title="HIP Toolkit">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Custom title bar -->
            <RowDefinition Height="*"/>     <!-- Drop zone -->
            <RowDefinition Height="Auto"/>  <!-- Settings bar -->
            <RowDefinition Height="Auto"/>  <!-- Results -->
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Custom title bar ═══ -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: action buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="BtnOpenFile" Click="OpenFile_Click"
                        ToolTipService.ToolTip="Open a file for inspection"
                        Background="Transparent" BorderBrush="Transparent" Padding="8">
                    <FontIcon Glyph="&#xED25;" FontSize="16"/>
                </Button>
                <Button x:Name="BtnDonate" Click="Donate_Click"
                        ToolTipService.ToolTip="Support Us"
                        Background="Transparent" BorderBrush="Transparent" Padding="8">
                    <FontIcon Glyph="&#xEB51;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Center: Category tabs -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                        VerticalAlignment="Center">
                <RadioButton x:Name="RadioCIF" Content="CIF" GroupName="Category"
                             IsChecked="True" Click="Category_Click"
                             Style="{StaticResource DefaultToggleButtonStyle}" MinWidth="60" />
                <RadioButton x:Name="RadioCiftree" Content="Ciftree" GroupName="Category"
                             Click="Category_Click"
                             Style="{StaticResource DefaultToggleButtonStyle}" MinWidth="60" />
                <RadioButton x:Name="RadioHIS" Content="HIS" GroupName="Category"
                             Click="Category_Click"
                             Style="{StaticResource DefaultToggleButtonStyle}" MinWidth="60" />
            </StackPanel>
        </Grid>

        <!-- ═══ Row 1: Drop zone ═══ -->
        <Border Grid.Row="1" x:Name="DropZone"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1.5" CornerRadius="16"
                Background="Transparent" Margin="16,8,16,8"
                AllowDrop="True"
                DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                PointerPressed="DropZone_Click">
            <Grid>
                <!-- Normal content -->
                <StackPanel x:Name="DropHint" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="10">
                    <FontIcon x:Name="DropIcon" Glyph="&#xE896;" FontSize="38"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropTitle" Text="Drag PNG, JPEG, Lua, XSheet or XSheet JSON files"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropSubtitle"
                               Text="PNG/JPEG → CIF image · Lua → CIF script · XSheet / JSON → CIF sprite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button x:Name="BtnChoose" Content="Choose Files…" Click="ChooseFiles_Click"
                            HorizontalAlignment="Center" />
                </StackPanel>
                <!-- Busy indicator -->
                <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ═══ Row 2: Settings bar (direction + options) ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    Padding="16,4,16,8">
            <RadioButton x:Name="RadioForward" Content="File → CIF" GroupName="Direction"
                         IsChecked="True" Click="Direction_Click"
                         Style="{StaticResource DefaultToggleButtonStyle}" MinWidth="80" />
            <RadioButton x:Name="RadioBackward" Content="CIF → File" GroupName="Direction"
                         Click="Direction_Click"
                         Style="{StaticResource DefaultToggleButtonStyle}" MinWidth="80" />

            <AppBarSeparator Margin="4,0"/>

            <CheckBox x:Name="ChkCompileLua" Content="Compile Lua" IsChecked="True"
                      ToolTipService.ToolTip="Compile .lua source to bytecode before packing"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkType4OVL" Content="Type 4 OVL"
                      ToolTipService.ToolTip="Encode PNG as CIF type 4 (OVL overlay) — Sea of Darkness"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkCapitalizeNames" Content="Capitalize names" Visibility="Collapsed"
                      ToolTipService.ToolTip="Uppercase entry names when packing"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkExtractContents" Content="Extract CIF contents" Visibility="Collapsed"
                      IsChecked="True"
                      ToolTipService.ToolTip="Automatically decode each CIF entry when unpacking"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkDecompileLua" Visibility="Collapsed"
                      ToolTipService.ToolTip="Run luadec on extracted Lua bytecode to produce readable source"
                      Checked="Setting_Changed" Unchecked="Setting_Changed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Decompile Lua" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="3"
                            Padding="4,1,4,1" VerticalAlignment="Center">
                        <TextBlock Text="β" FontSize="10" Foreground="White"/>
                    </Border>
                </StackPanel>
            </CheckBox>
        </StackPanel>

        <!-- ═══ Row 3: Results history ═══ -->
        <Grid Grid.Row="3" x:Name="ResultsPanel" Visibility="Collapsed" Padding="16,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,4,4">
                <TextBlock Text="History" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Button Content="Clear" Click="ClearResults_Click"
                        VerticalAlignment="Center" Padding="8,2" />
            </StackPanel>

            <ListView Grid.Row="1" x:Name="ResultsList" MaxHeight="200"
                      SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ConversionResult">
                        <Grid Padding="8,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="{x:Bind Icon}" FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
