<Window
    x:Class="HIPToolkit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HIPToolkit"
    Title="HIP Toolkit">

    <Grid>
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Custom title bar -->
            <RowDefinition Height="*"/>     <!-- Drop zone -->
            <RowDefinition Height="Auto"/>  <!-- Settings bar -->
            <RowDefinition Height="Auto"/>  <!-- Results -->
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Custom title bar ═══ -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: action buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="BtnOpenFile" Click="OpenFile_Click"
                        ToolTipService.ToolTip="Open a file for inspection"
                        Background="Transparent" BorderBrush="Transparent" Padding="8">
                    <FontIcon Glyph="&#xED25;" FontSize="16"/>
                </Button>
                <Button x:Name="BtnDonate" Click="Donate_Click"
                        ToolTipService.ToolTip="Support Us"
                        Background="Transparent" BorderBrush="Transparent" Padding="8">
                    <FontIcon Glyph="&#xEB51;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Center: Category selector -->
            <SelectorBar x:Name="CategoryBar" Grid.Column="1" VerticalAlignment="Center"
                         SelectionChanged="CategoryBar_SelectionChanged">
                <SelectorBarItem x:Name="ItemCIF"     Text="CIF"     Tag="CIF"/>
                <SelectorBarItem x:Name="ItemCiftree" Text="Ciftree" Tag="Ciftree"/>
                <SelectorBarItem x:Name="ItemHIS"     Text="HIS"     Tag="HIS"/>
            </SelectorBar>
        </Grid>

        <!-- ═══ Row 1: Drop zone ═══ -->
        <Border Grid.Row="1" x:Name="DropZone"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1.5" CornerRadius="16"
                Background="Transparent" Margin="16,8,16,8"
                AllowDrop="True"
                DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                PointerPressed="DropZone_Click">
            <Grid>
                <!-- Normal content -->
                <StackPanel x:Name="DropHint" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="10">
                    <FontIcon x:Name="DropIcon" Glyph="&#xE896;" FontSize="38"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropTitle" Text="Drag PNG, JPEG, Lua, XSheet or XSheet JSON files"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropSubtitle"
                               Text="PNG/JPEG → CIF image · Lua → CIF script · XSheet / JSON → CIF sprite"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button x:Name="BtnChoose" Content="Choose Files…" Click="ChooseFiles_Click"
                            HorizontalAlignment="Center" />
                </StackPanel>
                <!-- Busy panel (shown during processing) -->
                <StackPanel x:Name="BusyPanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                            Spacing="10" Margin="40,0">
                    <ProgressBar x:Name="ConvProgressBar" Value="0" Maximum="100"
                                 HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="ConvProgressLabel" Text=""
                               HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="BtnCancelConv" Content="Cancel"
                            HorizontalAlignment="Center"
                            Click="CancelConv_Click"
                            Padding="16,4"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 2: Settings bar (direction + options) ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    Padding="16,4,16,8">
            <RadioButton x:Name="RadioForward" Content="File → CIF" GroupName="Direction"
                         IsChecked="True" Click="Direction_Click"
                         Style="{StaticResource DefaultToggleButtonStyle}" MinWidth="80" />
            <RadioButton x:Name="RadioBackward" Content="CIF → File" GroupName="Direction"
                         Click="Direction_Click"
                         Style="{StaticResource DefaultToggleButtonStyle}" MinWidth="80" />

            <AppBarSeparator Margin="4,0"/>

            <CheckBox x:Name="ChkCompileLua" Content="Compile Lua" IsChecked="True"
                      ToolTipService.ToolTip="Compile .lua source to bytecode before packing"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkType4OVL" Content="Type 4 OVL"
                      ToolTipService.ToolTip="Encode PNG as CIF type 4 (OVL overlay) — Sea of Darkness"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkCapitalizeNames" Content="Capitalize names" Visibility="Collapsed"
                      ToolTipService.ToolTip="Uppercase entry names when packing"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkExtractContents" Content="Extract CIF contents" Visibility="Collapsed"
                      IsChecked="True"
                      ToolTipService.ToolTip="Automatically decode each CIF entry when unpacking"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
            <CheckBox x:Name="ChkDecompileLua" Visibility="Collapsed"
                      ToolTipService.ToolTip="Run luadec on extracted Lua bytecode to produce readable source"
                      Checked="Setting_Changed" Unchecked="Setting_Changed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Decompile Lua" VerticalAlignment="Center"/>
                    <TextBlock Text="β" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </CheckBox>

            <!-- HIS output format (visible only in HIS decode mode) -->
            <StackPanel x:Name="HisFormatPanel" Orientation="Horizontal" Spacing="8"
                        Visibility="Collapsed" VerticalAlignment="Center">
                <AppBarSeparator Margin="4,0"/>
                <TextBlock Text="Output" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="CmbHisFormat" SelectionChanged="HisFormat_Changed"
                          MinWidth="80">
                    <ComboBoxItem Content="OGG" Tag="ogg"/>
                    <ComboBoxItem Content="WAV" Tag="wav" IsSelected="True"/>
                    <ComboBoxItem Content="MP3" Tag="mp3"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- ═══ Row 3: Results history ═══ -->
        <Grid Grid.Row="3" x:Name="ResultsPanel" Visibility="Collapsed" Padding="16,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,4,4">
                <TextBlock Text="History" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Button Content="Clear" Click="ClearResults_Click"
                        VerticalAlignment="Center" Padding="8,2" />
            </StackPanel>

            <ListView Grid.Row="1" x:Name="ResultsList" MaxHeight="200"
                      SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ConversionResult">
                        <Grid>
                            <!-- Normal (non-expandable) row -->
                            <Grid Padding="8,6" ColumnSpacing="12"
                                  Visibility="{Binding IsExpandable, Converter={StaticResource InvBoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{x:Bind Icon}" FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Tag="{x:Bind RevealPath}"
                                        Click="RevealInExplorer_Click"
                                        Visibility="{Binding HasRevealPath, Converter={StaticResource BoolToVis}}"
                                        Background="Transparent" BorderBrush="Transparent" Padding="6"
                                        ToolTipService.ToolTip="Show in Explorer">
                                    <FontIcon Glyph="&#xEC50;" FontSize="14"/>
                                </Button>
                            </Grid>
                            <!-- Expandable (disclosure) row -->
                            <Expander HorizontalAlignment="Stretch" Padding="4,2"
                                      Visibility="{Binding IsExpandable, Converter={StaticResource BoolToVis}}">
                                <Expander.Header>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind Icon}" FontSize="16"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                                   FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander.Header>
                                <ScrollViewer MaxHeight="130">
                                    <TextBlock Text="{x:Bind Detail}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap" Padding="4"/>
                                </ScrollViewer>
                            </Expander>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
