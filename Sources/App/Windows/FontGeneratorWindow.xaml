<Window
    x:Class="HIPToolkit.FontGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bitmap Font Generator">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Custom title bar -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40" Padding="16,0">
            <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Settings column ═══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="16,4,16,16">

                    <!-- Font -->
                    <TextBlock x:Name="HdrFont" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch"
                              SelectionChanged="PresetBox_SelectionChanged"/>
                    <ComboBox x:Name="FamilyBox" HorizontalAlignment="Stretch"
                              SelectionChanged="FamilyBox_SelectionChanged"/>
                    <TextBox x:Name="NameBox"/>
                    <StackPanel x:Name="CustomSizePanel" Spacing="8">
                        <NumberBox x:Name="SizeBox" Minimum="4" Maximum="200" Value="12"
                                   SpinButtonPlacementMode="Inline" SmallChange="1"/>
                        <CheckBox x:Name="CellBox" IsChecked="True"/>
                    </StackPanel>
                    <Grid x:Name="PresetNotePanel" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PresetNote" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="BtnDetach" Grid.Column="1" Click="Detach_Click"/>
                    </Grid>

                    <!-- Styles -->
                    <TextBlock x:Name="HdrStyles" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                    <StackPanel x:Name="StylesPanel" Spacing="8"/>

                    <!-- Characters -->
                    <TextBlock x:Name="HdrChars" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                    <RadioButtons x:Name="EncodingBox" SelectionChanged="EncodingBox_SelectionChanged"/>
                    <StackPanel x:Name="CharsetsPanel" Spacing="0"/>
                    <TextBox x:Name="ExtraBox"/>
                    <TextBlock x:Name="Cp1252Note" TextWrapping="Wrap" Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Rendering -->
                    <TextBlock x:Name="HdrRender" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                    <ComboBox x:Name="HintingBox" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="AntialiasBox" HorizontalAlignment="Stretch"/>
                    <CheckBox x:Name="WhiteBox"/>
                    <NumberBox x:Name="SpacingBox" Minimum="0" Maximum="8" Value="0"
                               SpinButtonPlacementMode="Inline" SmallChange="1"/>
                    <NumberBox x:Name="PaddingBox" Minimum="0" Maximum="4" Value="0"
                               SpinButtonPlacementMode="Inline" SmallChange="1"/>
                    <CheckBox x:Name="KerningBox" IsChecked="True"/>
                    <CheckBox x:Name="CifBox"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="BtnGenerate" Style="{StaticResource AccentButtonStyle}" Click="Generate_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Enter"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button x:Name="BtnExport" IsEnabled="False" Click="Export_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Preview column ═══ -->
            <Grid Grid.Column="1" Padding="16,4,16,16" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="PreviewStyleBar" SelectionChanged="PreviewStyleBar_SelectionChanged">
                        <SelectorBarItem Text="Regular" Tag="0" IsSelected="True"/>
                        <SelectorBarItem Text="Bold" Tag="1"/>
                        <SelectorBarItem Text="Italic" Tag="2"/>
                        <SelectorBarItem Text="Bold Italic" Tag="3"/>
                    </SelectorBar>
                    <NumberBox x:Name="ScaleBox" Grid.Column="1" Minimum="1" Maximum="6" Value="2"
                               SpinButtonPlacementMode="Inline" SmallChange="1" VerticalAlignment="Center"
                               ValueChanged="ScaleBox_ValueChanged"/>
                </Grid>

                <TextBox x:Name="SampleBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         MaxHeight="96" TextChanged="SampleBox_TextChanged"/>

                <Border Grid.Row="2" x:Name="SampleBorder" CornerRadius="8" Background="#294D8C"
                        MinHeight="70" MaxHeight="160">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="SampleImage" Stretch="None" Margin="8"
                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="AtlasInfo" Grid.Row="3" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                <Border Grid.Row="4" CornerRadius="8"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ZoomMode="Disabled">
                            <Border x:Name="AtlasBorder" Background="#294D8C"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                <Image x:Name="AtlasImage" Stretch="None"/>
                            </Border>
                        </ScrollViewer>
                        <TextBlock x:Name="HintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="5" x:Name="MissingPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="MissingHeader" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MissingText" FontSize="14" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
