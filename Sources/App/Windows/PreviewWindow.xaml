<Window
    x:Class="HIPToolkit.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HIP Toolkit — Preview">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <TabView x:Name="TabStrip"
             TabCloseRequested="OnTabCloseRequested"
             AddTabButtonClick="OnAddTabButtonClick"
             IsAddTabButtonVisible="True"
             TabWidthMode="SizeToContent"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop"
             VerticalAlignment="Stretch">

        <!-- ── Left toolbar: open file + reveal in explorer ── -->
        <TabView.TabStripHeader>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Spacing="2" Margin="8,0,4,0">
                <Button x:Name="BtnOpenFile"
                        Padding="8" MinWidth="0"
                        ToolTipService.ToolTip="Open file for inspection (Ctrl+O)"
                        Click="BtnOpenFile_Click">
                    <FontIcon Glyph="&#xED25;" FontSize="14"/>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="BtnReveal"
                        Padding="8" MinWidth="0"
                        ToolTipService.ToolTip="Reveal in File Explorer"
                        Click="BtnReveal_Click">
                    <FontIcon Glyph="&#xEC50;" FontSize="14"/>
                </Button>
            </StackPanel>
        </TabView.TabStripHeader>

        <!-- ── Right side: drop hint when empty ── -->
        <TabView.TabStripFooter>
            <TextBlock x:Name="DropHint"
                       Text="Drop files here"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,12,0"
                       FontSize="12"
                       Visibility="Collapsed"/>
        </TabView.TabStripFooter>

    </TabView>
</Window>