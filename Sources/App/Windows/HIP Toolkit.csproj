<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HIPToolkit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Read version from shared VERSION file in repo root -->
    <Version>$([System.IO.File]::ReadAllText('$(SolutionDir)VERSION').Trim())</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <ApplicationIcon>$(SolutionDir)Toolkit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <!-- Strings JSON — single source of truth for all UI strings -->
  <ItemGroup>
    <Content Include="$(SolutionDir)Sources\Strings\en.json" CopyToOutputDirectory="PreserveNewest" Link="Strings\en.json" />
  </ItemGroup>

  <!-- luadec binaries — select the right one at runtime via RuntimeInformation -->
  <ItemGroup>
    <Content Include="$(SolutionDir)Vendor\luadec-win-x64.exe" CopyToOutputDirectory="PreserveNewest" Link="luadec-win-x64.exe" />
    <Content Include="$(SolutionDir)Vendor\luadec-win-arm64.exe" CopyToOutputDirectory="PreserveNewest" Link="luadec-win-arm64.exe" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\..\Toolkit.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Path to the native bridge DLL produced by the HIP.Bridge (C++) project. -->
  <PropertyGroup>
    <HIPBridgeDll>$(SolutionDir)build\$(Platform)\$(Configuration)\HIP.Bridge\HIP.Bridge.dll</HIPBridgeDll>
    <Authors>Mike Lucyšyn, Nancy Drew Hub</Authors>
    <Title>$(AssemblyName)</Title>
    <RepositoryUrl>https://github.com/loinik/hip-toolkit</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Toolkit.png</PackageIcon>
    <PackageProjectUrl>https://nancydrew.me/kit/toolkit</PackageProjectUrl>
    <Copyright>© 2026 Mike Lucyšyn × Nancy Drew Hub</Copyright>
    <Description>This project is for educational and preservation purposes only. It is not affiliated with or endorsed by HeR Interactive, inc. Use responsibly and respect copyright holders' rights.</Description>
  </PropertyGroup>

  <!--
    Copy the native bridge DLL next to the C# executable.
    The HIP.Bridge (C++) project is ordered before this one via the build
    dependency declared in HIP Toolkit.sln, so by the time Build finishes the
    DLL exists. We copy into $(OutDir) — the real runtime folder, including the
    RID subfolder (e.g. win-x64) that WinUI 3 self-contained apps run from.
    If the DLL is missing we fail the build loudly instead of letting the app
    start and crash later with "Unable to load DLL 'HIP.Bridge'" (0x8007007E).
  -->
  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <Error Condition="!Exists('$(HIPBridgeDll)')" Text="HIP.Bridge.dll was not found at '$(HIPBridgeDll)'. The native HIP.Bridge (C++) project must be built for $(Platform)/$(Configuration) before the app. Building the whole solution does this automatically via the build dependency declared in HIP Toolkit.sln." />
    <Copy SourceFiles="$(HIPBridgeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeBridgeToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(HIPBridgeDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Copy resources.pri into the publish folder. WinUI 3 loads its XAML metadata
    from resources.pri at startup; without it the app dies immediately with
    STATUS_STOWED_EXCEPTION (0xc000027b) in combase.dll. `dotnet publish` copies
    it automatically, but `msbuild /t:Publish` (which we must use so WindowsAppSDK's
    PRI task loads from VS, not the .NET SDK) leaves it in $(OutDir) and does not
    propagate it to $(PublishDir). Copy it ourselves.
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <Copy Condition="Exists('$(OutDir)resources.pri')"
          SourceFiles="$(OutDir)resources.pri"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
